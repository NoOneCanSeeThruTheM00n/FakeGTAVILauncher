{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTA VI Launcher",
  "version": "0.1.0",
  "identifier": "com.noonecanseethruthemoon.fakegtavi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rockstar Games Launcher — GTA VI",
        "width": 1280,
        "height": 760,
        "minWidth": 760,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NoOneCanSeeThruTheM00n",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
